    "sentences": [
      {
        "ref": "open-pocket/s1",
        "text": "Maya arrives at the station early.",
        "translation_de": "Maya kommt früh am Bahnhof an.",
        "origins": [
          "story"
        ]
      },
      {
        "ref": "open-pocket/s2",
        "text": "She puts her backpack on a table in the café.",
        "translation_de": "Sie stellt ihren Rucksack auf einen Tisch im Café.",
        "origins": [
          "story"
        ]
      },
      {
        "ref": "open-pocket/s3",
        "text": "A man points to the open pocket of her backpack.",
        "translation_de": "Ein Mann zeigt auf das offene Fach ihres Rucksacks.",
        "origins": [
          "story"
        ]
      },
      {
        "ref": "open-pocket/s4",
        "text": "Her train ticket is about to fall out.",
        "translation_de": "Ihre Fahrkarte droht herauszufallen.",
        "origins": [
          "story"
        ]
      },
      {
        "ref": "open-pocket/s5",
        "text": "Maya puts it safely inside and thanks the man.",
        "translation_de": "Maya steckt sie sicher hinein und bedankt sich bei dem Mann.",
        "origins": [
          "story"
        ]
      },
      {
        "ref": "open-pocket/s6",
        "text": "Then she walks to the platform for her train.",
        "translation_de": "Dann geht sie zum Bahnsteig für ihren Zug.",
        "origins": [
          "story"
        ]
      }
    ],
