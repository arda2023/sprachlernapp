 "sentences": [
  {
   "ref": "s1",
   "text": "She went home after work.",
   "translation_de": "Sie ging nach der Arbeit nach Hause.",
   "origins": [
    "deck"
   ]
  },
  {
   "ref": "s2",
   "text": "We went to the beach on Sunday.",
   "translation_de": "Wir gingen am Sonntag an den Strand.",
   "origins": [
    "deck"
   ]
  },
  {
   "ref": "s3",
   "text": "My brother went to bed early.",
   "translation_de": "Mein Bruder ging früh ins Bett.",
   "origins": [
    "deck"
   ]
  },
  {
   "ref": "s4",
   "text": "He left the house at seven.",
   "translation_de": "Er verließ das Haus um sieben.",
   "origins": [
    "deck"
   ]
  },
  {
   "ref": "s5",
   "text": "They left the party before midnight.",
   "translation_de": "Sie verließen die Party vor Mitternacht.",
   "origins": [
    "deck"
   ]
  },
  {
   "ref": "s6",
   "text": "She left her job last year.",
   "translation_de": "Sie hat letztes Jahr ihre Stelle verlassen.",
   "origins": [
    "deck"
   ]
  },
  {
   "ref": "s7",
   "text": "She raised her left hand.",
   "translation_de": "Sie hob ihre linke Hand.",
   "origins": [
    "deck"
   ]
  },
  {
   "ref": "s8",
   "text": "He broke his left arm last summer.",
   "translation_de": "Er brach sich letzten Sommer den linken Arm.",
   "origins": [
    "deck"
   ]
  },
  {
   "ref": "s9",
   "text": "My left shoe is wet.",
   "translation_de": "Mein linker Schuh ist nass.",
   "origins": [
    "deck"
   ]
  }
 ],
